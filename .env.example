# Copy to .env (make up does it for you). Never commit .env.

# Database (local Docker)
POSTGRES_USER=studeal
POSTGRES_PASSWORD=studeal
POSTGRES_DB=studeal
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://studeal:studeal@db:5432/studeal

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cognito sign-in (from the AWS person). Empty = auth off: every request acts as one local user.
# COGNITO_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/<user pool id>
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# AWS sign-in setup only (infra/aws/07-auth.sh, make deploy-auth). Not needed to run locally.
# Google OAuth web client, see infra/README.md "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
